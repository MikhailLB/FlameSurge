<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP is disabled globally. If a specific partner domain must be
    reached over http:// during testing, add it here as a `<domain-config
    cleartextTrafficPermitted="true">` block.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
