migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/android/.gradle/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing (do not commit to public repo)
/android/key.properties
/android/keystore/

# Firebase / attribution credentials — keep OUT of a public repo.
# Firebase's own API key is SHA-1 restricted so it's not a hard secret,
# but shipping the project id/link in the repo makes the app trivially
# fingerprintable. Restore locally before building signed release artifacts.
/android/app/google-services.json
